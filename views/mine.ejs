<%- include('_head') %><h1>Mes guides</h1>
<% if (!guides.length) { %><p class="mut">Vous n'avez pas encore de guide. <a href="/new">Créer mon premier guide</a></p><% } %>
<div class="grid"><% guides.forEach(g => { %><%- include('_card', { g }) %><% }) %></div><h2>Mes outils de diagnostic</h2><p><a class="btn secondary small" href="/diag/new">Créer un outil de diagnostic</a></p>
<% diags.forEach(d => { %><div class="box"><a href="/diag/<%= d.id %>"><b><%= d.title %></b></a> <span class="tag st-<%= d.status %>"><%= d.status === 'approved' ? 'Publié' : d.status === 'pending' ? 'En attente' : 'Refusé' %></span>
<a class="small" href="/diag/<%= d.id %>/edit">Modifier</a></div><% }) %>
<%- include('_foot') %>
